# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/collabspace

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Allowed web client origin(s), comma separated
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads

# Optional: raises the GitHub API rate limit for repository stats
# GITHUB_TOKEN=
